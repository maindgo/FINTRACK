        && incoming().reviewedAt == request.time
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'reviewedBy', 'reviewedAt', 'updatedAt']);
      allow delete: if isMaintenanceAdmin() && isValidId(requestId);
    }
  }
}
