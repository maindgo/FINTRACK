      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tier": { "type": "string", "enum": ["starter", "silver", "gold", "diamond"] },
        "periodKey": { "type": "string", "minLength": 4, "maxLength": 40 },
