{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and financial workspace preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching document ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "AUD", "CAD", "JPY"],
          "description": "Preferred display currency code."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "UI color theme preference."
        },
        "monthlyBudgetLimit": {
          "type": "number",
          "description": "Overall monthly spending limit in user currency."
        },
        "openingBankBalance": {
          "type": "number",
          "description": "User-entered opening or in-hand balance in Bank / UPI accounts."
        },
        "openingCashBalance": {
          "type": "number",
          "description": "User-entered opening or in-hand physical cash balance."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "deactivated"],
          "description": "Account lifecycle status controlled exclusively by verified admin."
        },
        "deactivatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was deactivated, or null when active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "email", "displayName", "currency", "theme", "monthlyBudgetLimit", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual income or expense entry recorded by the user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Salary",
            "Freelancing",
            "Business Income",
            "Online Earnings",
            "Investments",
            "Interest",
            "Other Income",
            "Food",
            "Shopping",
            "Transport",
            "Rent",
            "Electricity",
            "Internet",
            "Education",
            "Healthcare",
            "Entertainment",
            "Travel",
            "EMI",
            "Bills",
            "Other Expenses"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "maxLength": 10
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Bank Transfer", "Cash", "Credit Card", "Debit Card", "Wallet", "Net Banking", "Other"]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "receiptName": {
          "type": "string",
          "maxLength": 160
        },
        "receiptDataUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "amount", "title", "category", "date", "time", "paymentMethod", "description", "notes", "receiptName", "receiptDataUrl", "recurringId", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
