{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and financial workspace preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching document ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "AUD", "CAD", "JPY"],
          "description": "Preferred display currency code."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "UI color theme preference."
        },
        "monthlyBudgetLimit": {
          "type": "number",
          "description": "Overall monthly spending limit in user currency."
        },
        "openingBankBalance": {
          "type": "number",
          "description": "User-entered opening or in-hand balance in Bank / UPI accounts."
        },
        "openingCashBalance": {
          "type": "number",
          "description": "User-entered opening or in-hand physical cash balance."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "deactivated"],
          "description": "Account lifecycle status controlled exclusively by verified admin."
        },
        "deactivatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was deactivated, or null when active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "email", "displayName", "currency", "theme", "monthlyBudgetLimit", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual income or expense entry recorded by the user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Salary",
            "Freelancing",
            "Business Income",
            "Online Earnings",
            "Investments",
            "Interest",
            "Other Income",
            "Food",
            "Shopping",
            "Transport",
            "Rent",
            "Electricity",
            "Internet",
            "Education",
            "Healthcare",
            "Entertainment",
            "Travel",
            "EMI",
            "Bills",
            "Other Expenses"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "maxLength": 10
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Bank Transfer", "Cash", "Credit Card", "Debit Card", "Wallet", "Net Banking", "Other"]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "receiptName": {
          "type": "string",
          "maxLength": 160
        },
        "receiptDataUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "amount", "title", "category", "date", "time", "paymentMethod", "description", "notes", "receiptName", "receiptDataUrl", "recurringId", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Target-based savings goal with tracked progress.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetAmount": {
          "type": "number"
        },
        "savedAmount": {
          "type": "number"
        },
        "targetDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "targetAmount", "savedAmount", "targetDate", "category", "notes", "status", "createdAt", "updatedAt"]
    },
    "SavingsContribution": {
      "title": "SavingsContribution",
      "description": "Deposit record linked to a savings goal.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "goalId", "amount", "date", "note", "createdAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly category-wise spending budget.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "minLength": 7,
          "maxLength": 7
        },
        "limitAmount": {
          "type": "number"
        },
        "alertThreshold": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "category", "month", "limitAmount", "alertThreshold", "notes", "createdAt", "updatedAt"]
    },
    "DebtRecord": {
      "title": "DebtRecord",
      "description": "Personal financial record for lent money, borrowed money, receivables, payables, and loans.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordType": {
          "type": "string",
          "enum": ["lent", "borrowed", "receivable", "payable", "loan"]
        },
        "partyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "totalAmount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "interestRate": {
          "type": "number"
        },
        "dueDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["unpaid", "partially_paid", "paid", "overdue"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "recordType", "partyName", "title", "totalAmount", "paidAmount", "interestRate", "dueDate", "status", "notes", "createdAt", "updatedAt"]
    },
    "RecordPayment": {
      "title": "RecordPayment",
      "description": "Payment history entry against a debt record or bill.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentKind": {
          "type": "string",
          "enum": ["debt", "bill"]
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "method": {
          "type": "string",
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "parentKind", "parentId", "amount", "date", "method", "note", "createdAt"]
    },
    "BillRecord": {
      "title": "BillRecord",
      "description": "Monthly bills, EMIs, and subscriptions tracker.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "billType": {
          "type": "string",
          "enum": ["bill", "emi", "subscription"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "provider": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "amount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "dueDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "frequency": {
          "type": "string",
          "enum": ["one_time", "monthly", "quarterly", "yearly"]
        },
        "status": {
          "type": "string",
          "enum": ["unpaid", "partially_paid", "paid", "overdue"]
        },
        "autoPay": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "billType", "title", "provider", "category", "amount", "paidAmount", "dueDate", "frequency", "status", "autoPay", "notes", "createdAt", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Scheduled recurring income or expense rule.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Bank Transfer", "Cash", "Credit Card", "Debit Card", "Wallet", "Net Banking", "Other"]
        },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "yearly"]
        },
        "startDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "nextRunDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "lastRunDate": {
          "type": "string",
          "maxLength": 10
        },
        "isActive": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "title", "amount", "category", "paymentMethod", "frequency", "startDate", "nextRunDate", "lastRunDate", "isActive", "description", "createdAt", "updatedAt"]
    },
    "MaintenanceConfig": {
      "title": "MaintenanceConfig",
      "description": "Global application maintenance mode toggle controlled exclusively by verified admin.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the application is currently in scheduled maintenance mode."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last maintenance toggle."
        }
      },
      "required": ["enabled", "updatedAt"]
    },
    "AdminMessage": {
      "title": "AdminMessage",
      "description": "Pop-up message sent by the verified FinTrack administrator to a user account.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "isRead": {
          "type": "boolean"
        },
        "readAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "heading", "message", "senderEmail", "isRead", "readAt", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/MaintenanceConfig" },
      "description": "Publicly readable non-PII global app configuration (restricted to 'maintenance' document, writable only by verified admin)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, currency, theme, and overall monthly budget setting."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User-owned income and expense ledger entries."
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "User-owned savings goals."
    },
    "/users/{userId}/savingsGoals/{goalId}/contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/SavingsContribution" },
      "description": "Contributions made toward a specific savings goal."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Monthly category-wise spending limits."
    },
    "/users/{userId}/debtRecords/{recordId}": {
      "schema": { "$ref": "#/entities/DebtRecord" },
      "description": "Loans, money lent/borrowed, receivables, and payables."
    },
    "/users/{userId}/recordPayments/{paymentId}": {
      "schema": { "$ref": "#/entities/RecordPayment" },
      "description": "Payment history log referencing a debtRecord or bill."
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/BillRecord" },
      "description": "Bills, EMIs, and recurring subscriptions."
    },
    "/users/{userId}/recurringTransactions/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringTransaction" },
      "description": "Scheduled recurring income and expense templates."
    },
    "/users/{userId}/adminMessages/{messageId}": {
      "schema": { "$ref": "#/entities/AdminMessage" },
      "description": "Important administrative pop-up messages sent to user accounts."
    }
  }
}
