    "SecurityProfile": {
      "title": "SecurityProfile",
      "description": "Admin-controlled account restriction, ban state, AI/messaging limits, VIP entitlement, and evidence risk classification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "restrictionStatus": { "type": "string", "enum": ["active", "under_investigation", "temp_banned", "perm_banned"] },
        "banType": { "type": "string", "enum": ["none", "temporary", "permanent"] },
        "banReason": { "type": "string", "maxLength": 500 },
        "banDurationLabel": { "type": "string", "maxLength": 64 },
