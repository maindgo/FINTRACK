        "aiRestrictedUntil": { "type": "string", "format": "date-time" },
        "messagingRestrictedUntil": { "type": "string", "format": "date-time" },
        "warningCount": { "type": "number" },
        "lastWarningAt": { "type": "string", "format": "date-time" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "riskScore": { "type": "number" },
        "underInvestigation": { "type": "boolean" },
        "vipStatus": { "type": "string", "enum": ["none", "vip"] },
        "eventCount": { "type": "number" },
        "lastEventAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "displayName", "restrictionStatus", "banType", "banReason", "banDurationLabel", "banDurationMs", "banStartedAt", "banExpiresAt", "aiRestrictedUntil", "messagingRestrictedUntil", "warningCount", "lastWarningAt", "riskLevel", "riskScore", "underInvestigation", "vipStatus", "eventCount", "lastEventAt", "updatedBy", "createdAt", "updatedAt"]
    },
