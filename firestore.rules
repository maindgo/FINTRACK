rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isMaintenanceAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'maind.go2000@gmail.com';
    }

    function isNotBanned(userId) {
      return !exists(/databases/$(database)/documents/securityProfiles/$(userId))
        || get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banType == 'none'
        || (
          get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banType == 'temporary'
          && get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banExpiresAt != null
          && get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banExpiresAt <= request.time
        );
    }

    function isNotMessagingRestricted(userId) {
      return !exists(/databases/$(database)/documents/securityProfiles/$(userId))
        || get(/databases/$(database)/documents/securityProfiles/$(userId)).data.messagingRestrictedUntil == null
        || get(/databases/$(database)/documents/securityProfiles/$(userId)).data.messagingRestrictedUntil <= request.time;
    }

    function isBannedOrDeactivated(userId) {
      return (
        exists(/databases/$(database)/documents/users/$(userId))
        && 'accountStatus' in get(/databases/$(database)/documents/users/$(userId)).data
        && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'deactivated'
      ) || (
        exists(/databases/$(database)/documents/securityProfiles/$(userId))
        && (
          get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banType == 'permanent'
          || (
            get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banType == 'temporary'
            && get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banExpiresAt != null
            && get(/databases/$(database)/documents/securityProfiles/$(userId)).data.banExpiresAt > request.time
          )
        )
      );
    }

    function isActiveAccount(userId) {
      return (
        !exists(/databases/$(database)/documents/users/$(userId))
        || !('accountStatus' in get(/databases/$(database)/documents/users/$(userId)).data)
        || get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active'
      ) && isNotBanned(userId);
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthStr(m) {
      return m is string && m.size() == 7 && m.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidPaymentMethod(pm) {
      return pm in ['UPI', 'Bank Transfer', 'Cash', 'Credit Card', 'Debit Card', 'Wallet', 'Net Banking', 'Other'];
    }

    function isValidIncomeCategory(c) {
      return c in ['Salary', 'Freelancing', 'Business Income', 'Online Earnings', 'Investments', 'Interest', 'Other Income'];
    }

    function isValidExpenseCategory(c) {
      return c in ['Food', 'Shopping', 'Transport', 'Rent', 'Electricity', 'Internet', 'Education', 'Healthcare', 'Entertainment', 'Travel', 'EMI', 'Bills', 'Other Expenses'];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'currency', 'theme', 'monthlyBudgetLimit', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'currency', 'theme', 'monthlyBudgetLimit', 'openingBankBalance', 'openingCashBalance', 'accountStatus', 'deactivatedAt', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'SGD', 'AUD', 'CAD', 'JPY']
        && data.theme in ['light', 'dark']
        && data.monthlyBudgetLimit is number && data.monthlyBudgetLimit >= 0 && data.monthlyBudgetLimit <= 1000000000
        && (!('openingBankBalance' in data) || (data.openingBankBalance is number && data.openingBankBalance >= 0 && data.openingBankBalance <= 1000000000))
        && (!('openingCashBalance' in data) || (data.openingCashBalance is number && data.openingCashBalance >= 0 && data.openingCashBalance <= 1000000000))
        && (!('accountStatus' in data) || data.accountStatus in ['active', 'deactivated'])
        && (!('deactivatedAt' in data) || data.deactivatedAt == null || data.deactivatedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'title', 'category', 'date', 'time', 'paymentMethod', 'description', 'notes', 'receiptName', 'receiptDataUrl', 'recurringId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'title', 'category', 'date', 'time', 'paymentMethod', 'description', 'notes', 'receiptName', 'receiptDataUrl', 'recurringId', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && ((data.type == 'income' && isValidIncomeCategory(data.category)) || (data.type == 'expense' && isValidExpenseCategory(data.category)))
        && isValidDateStr(data.date)
        && data.time is string && data.time.size() <= 10
        && isValidPaymentMethod(data.paymentMethod)
        && data.description is string && data.description.size() <= 500
        && data.notes is string && data.notes.size() <= 1000
        && data.receiptName is string && data.receiptName.size() <= 160
        && data.receiptDataUrl is string && data.receiptDataUrl.size() <= 250000
        && data.recurringId is string && data.recurringId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsGoal(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'targetAmount', 'savedAmount', 'targetDate', 'category', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'targetAmount', 'savedAmount', 'targetDate', 'category', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.targetAmount is number && data.targetAmount > 0 && data.targetAmount <= 1000000000
        && data.savedAmount is number && data.savedAmount >= 0 && data.savedAmount <= 1000000000
        && isValidDateStr(data.targetDate)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.notes is string && data.notes.size() <= 500
        && data.status in ['active', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsContribution(data, userId, goalId) {
      return data.keys().hasAll(['userId', 'goalId', 'amount', 'date', 'note', 'createdAt'])
        && data.keys().hasOnly(['userId', 'goalId', 'amount', 'date', 'note', 'createdAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.goalId == goalId
        && isValidId(data.goalId)
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && isValidDateStr(data.date)
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['userId', 'category', 'month', 'limitAmount', 'alertThreshold', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'category', 'month', 'limitAmount', 'alertThreshold', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && isValidMonthStr(data.month)
        && data.limitAmount is number && data.limitAmount > 0 && data.limitAmount <= 1000000000
        && data.alertThreshold is number && data.alertThreshold >= 50 && data.alertThreshold <= 100
        && data.notes is string && data.notes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDebtRecord(data, userId) {
      return data.keys().hasAll(['userId', 'recordType', 'partyName', 'title', 'totalAmount', 'paidAmount', 'interestRate', 'dueDate', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'recordType', 'partyName', 'title', 'totalAmount', 'paidAmount', 'interestRate', 'dueDate', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.recordType in ['lent', 'borrowed', 'receivable', 'payable', 'loan']
        && data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 1000000000
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.totalAmount
        && data.interestRate is number && data.interestRate >= 0 && data.interestRate <= 100
        && isValidDateStr(data.dueDate)
        && data.status in ['unpaid', 'partially_paid', 'paid', 'overdue']
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecordPayment(data, userId) {
      return data.keys().hasAll(['userId', 'parentKind', 'parentId', 'amount', 'date', 'method', 'note', 'createdAt'])
        && data.keys().hasOnly(['userId', 'parentKind', 'parentId', 'amount', 'date', 'method', 'note', 'createdAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.parentKind in ['debt', 'bill']
        && isValidId(data.parentId)
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && isValidDateStr(data.date)
        && data.method is string && data.method.size() >= 1 && data.method.size() <= 40
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidBillRecord(data, userId) {
      return data.keys().hasAll(['userId', 'billType', 'title', 'provider', 'category', 'amount', 'paidAmount', 'dueDate', 'frequency', 'status', 'autoPay', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'billType', 'title', 'provider', 'category', 'amount', 'paidAmount', 'dueDate', 'frequency', 'status', 'autoPay', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.billType in ['bill', 'emi', 'subscription']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.provider is string && data.provider.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.amount
        && isValidDateStr(data.dueDate)
        && data.frequency in ['one_time', 'monthly', 'quarterly', 'yearly']
        && data.status in ['unpaid', 'partially_paid', 'paid', 'overdue']
        && data.autoPay is bool
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecurringTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'title', 'amount', 'category', 'paymentMethod', 'frequency', 'startDate', 'nextRunDate', 'lastRunDate', 'isActive', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'title', 'amount', 'category', 'paymentMethod', 'frequency', 'startDate', 'nextRunDate', 'lastRunDate', 'isActive', 'description', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.type in ['income', 'expense']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && ((data.type == 'income' && isValidIncomeCategory(data.category)) || (data.type == 'expense' && isValidExpenseCategory(data.category)))
        && isValidPaymentMethod(data.paymentMethod)
        && data.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.nextRunDate)
        && data.lastRunDate is string && (data.lastRunDate == '' || isValidDateStr(data.lastRunDate))
        && data.isActive is bool
        && data.description is string && data.description.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaintenanceConfig(data) {
      return data.keys().hasAll(['enabled', 'updatedAt'])
        && data.keys().hasOnly(['enabled', 'updatedAt'])
        && data.enabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidAdminMessage(data, userId) {
      return data.keys().hasAll(['userId', 'heading', 'message', 'senderEmail', 'isRead', 'readAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'heading', 'message', 'senderEmail', 'isRead', 'readAt', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.heading is string && data.heading.size() >= 1 && data.heading.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1500
        && data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 160
        && data.isRead is bool
        && (data.readAt == null || data.readAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityProfile(data, userId) {
      return data.keys().hasAll(['userId', 'userEmail', 'displayName', 'restrictionStatus', 'banType', 'banReason', 'banDurationLabel', 'banDurationMs', 'banStartedAt', 'banExpiresAt', 'aiRestrictedUntil', 'messagingRestrictedUntil', 'warningCount', 'lastWarningAt', 'riskLevel', 'riskScore', 'underInvestigation', 'vipStatus', 'eventCount', 'lastEventAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'displayName', 'restrictionStatus', 'banType', 'banReason', 'banDurationLabel', 'banDurationMs', 'banStartedAt', 'banExpiresAt', 'aiRestrictedUntil', 'messagingRestrictedUntil', 'warningCount', 'lastWarningAt', 'riskLevel', 'riskScore', 'underInvestigation', 'vipStatus', 'eventCount', 'lastEventAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.restrictionStatus in ['active', 'under_investigation', 'temp_banned', 'perm_banned']
        && data.banType in ['none', 'temporary', 'permanent']
        && data.banReason is string && data.banReason.size() <= 500
        && data.banDurationLabel is string && data.banDurationLabel.size() <= 64
        && data.banDurationMs is number && data.banDurationMs >= 0 && data.banDurationMs <= 315360000000
        && (data.banStartedAt == null || data.banStartedAt is timestamp)
        && (data.banExpiresAt == null || data.banExpiresAt is timestamp)
        && (data.aiRestrictedUntil == null || data.aiRestrictedUntil is timestamp)
        && (data.messagingRestrictedUntil == null || data.messagingRestrictedUntil is timestamp)
        && data.warningCount is number && data.warningCount >= 0 && data.warningCount <= 10000
        && (data.lastWarningAt == null || data.lastWarningAt is timestamp)
        && data.riskLevel in ['low', 'medium', 'high', 'critical']
        && data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100
        && data.underInvestigation is bool
        && data.vipStatus in ['none', 'vip']
        && data.eventCount is number && data.eventCount >= 0 && data.eventCount <= 1000000
        && (data.lastEventAt == null || data.lastEventAt is timestamp)
        && data.updatedBy is string && data.updatedBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityCase(data, userId) {
      return data.keys().hasAll(['userId', 'internalNotes', 'evidenceSummary', 'lastReviewedBy', 'lastReviewedAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'internalNotes', 'evidenceSummary', 'lastReviewedBy', 'lastReviewedAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.internalNotes is string && data.internalNotes.size() <= 3000
        && data.evidenceSummary is string && data.evidenceSummary.size() <= 2000
        && data.lastReviewedBy is string && data.lastReviewedBy.size() <= 160
        && (data.lastReviewedAt == null || data.lastReviewedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidSecurityEvent(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'category', 'eventType', 'riskLevel', 'riskScore', 'summary', 'evidence', 'source', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'category', 'eventType', 'riskLevel', 'riskScore', 'summary', 'evidence', 'source', 'status', 'createdAt'])
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() <= 160
        && data.category in ['account_security', 'vip_payment_security', 'api_backend_security', 'data_security', 'messaging_security']
        && data.eventType is string && data.eventType.size() >= 3 && data.eventType.size() <= 64
        && data.riskLevel in ['low', 'medium', 'high', 'critical']
        && data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 300
        && data.evidence is string && data.evidence.size() <= 1500
        && data.source in ['client', 'backend', 'admin']
        && data.status in ['open', 'reviewed', 'dismissed']
        && data.createdAt is timestamp;
    }

    function isValidSecurityAppeal(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'displayName', 'banType', 'banReason', 'appealReason', 'explanation', 'status', 'adminDecisionNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'displayName', 'banType', 'banReason', 'appealReason', 'explanation', 'status', 'adminDecisionNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.banType in ['temporary', 'permanent', 'none']
        && data.banReason is string && data.banReason.size() <= 500
        && data.appealReason is string && data.appealReason.size() >= 3 && data.appealReason.size() <= 160
        && data.explanation is string && data.explanation.size() >= 10 && data.explanation.size() <= 1500
        && data.status in ['pending', 'under_review', 'approved', 'rejected']
        && data.adminDecisionNote is string && data.adminDecisionNote.size() <= 1000
        && data.reviewedBy is string && data.reviewedBy.size() <= 160
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityAuditLog(data) {
      return data.keys().hasAll(['targetUserId', 'targetUserEmail', 'adminEmail', 'actionType', 'reason', 'details', 'durationLabel', 'createdAt'])
        && data.keys().hasOnly(['targetUserId', 'targetUserEmail', 'adminEmail', 'actionType', 'reason', 'details', 'durationLabel', 'createdAt'])
        && isValidId(data.targetUserId)
        && data.targetUserEmail is string && data.targetUserEmail.size() <= 160
        && data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 160
        && data.actionType is string && data.actionType.size() >= 3 && data.actionType.size() <= 64
        && data.reason is string && data.reason.size() <= 500
        && data.details is string && data.details.size() <= 1000
        && data.durationLabel is string && data.durationLabel.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidVipPrice(tier, cycle, price) {
      return (tier == 'starter' && ((cycle == 'monthly' && price == 39) || (cycle == 'quarterly' && price == 99) || (cycle == 'yearly' && price == 129)))
        || (tier == 'silver' && ((cycle == 'monthly' && price == 49) || (cycle == 'quarterly' && price == 129) || (cycle == 'yearly' && price == 499)))
        || (tier == 'gold' && ((cycle == 'monthly' && price == 59) || (cycle == 'quarterly' && price == 149) || (cycle == 'yearly' && price == 599)))
        || (tier == 'diamond' && ((cycle == 'monthly' && price == 69) || (cycle == 'quarterly' && price == 179) || (cycle == 'yearly' && price == 699)));
    }

    function isValidVipSubscription(data, userId) {
      return data.keys().hasAll(['userId', 'tier', 'billingCycle', 'status', 'priceInr', 'paymentReference', 'periodKey', 'periodStartAt', 'periodEndAt', 'autoRenew', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'tier', 'billingCycle', 'status', 'priceInr', 'paymentReference', 'periodKey', 'periodStartAt', 'periodEndAt', 'autoRenew', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.tier in ['starter', 'silver', 'gold', 'diamond']
        && data.billingCycle in ['monthly', 'quarterly', 'yearly']
        && data.status in ['active', 'expired', 'cancelled']
        && data.priceInr is number
        && isValidVipPrice(data.tier, data.billingCycle, data.priceInr)
        && data.paymentReference is string && data.paymentReference.size() >= 3 && data.paymentReference.size() <= 100
        && data.paymentReference.matches('^(FTVIP|ADMIN)-[a-zA-Z0-9_\\-]+$')
        && data.periodKey is string && data.periodKey.size() >= 4 && data.periodKey.size() <= 40
        && data.periodStartAt is timestamp
        && data.periodEndAt is timestamp
        && data.autoRenew is bool
        && data.updatedBy is string && data.updatedBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiUsage(data, userId) {
      return data.keys().hasAll(['userId', 'tier', 'periodKey', 'periodStartAt', 'periodEndAt', 'insightsUsed', 'insightsLimit', 'advisorUsed', 'advisorLimit', 'forecastUsed', 'lastResetAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'tier', 'periodKey', 'periodStartAt', 'periodEndAt', 'insightsUsed', 'insightsLimit', 'advisorUsed', 'advisorLimit', 'forecastUsed', 'lastResetAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.tier in ['starter', 'silver', 'gold', 'diamond']
        && data.periodKey is string && data.periodKey.size() >= 4 && data.periodKey.size() <= 40
        && data.periodStartAt is timestamp
        && data.periodEndAt is timestamp
        && data.insightsUsed is number && data.insightsUsed >= 0 && data.insightsUsed <= 10000
        && data.insightsLimit is number && data.insightsLimit >= 0 && data.insightsLimit <= 10000
        && ((data.tier == 'starter' && data.insightsLimit == 0 && data.advisorLimit == 0)
          || (data.tier == 'silver' && data.insightsLimit == 10 && data.advisorLimit == 0)
          || (data.tier == 'gold' && data.insightsLimit == 30 && data.advisorLimit == 50)
          || (data.tier == 'diamond' && data.insightsLimit == 100 && data.advisorLimit == 200))
        && data.advisorUsed is number && data.advisorUsed >= 0 && data.advisorUsed <= 10000
        && data.advisorLimit is number && data.advisorLimit >= 0 && data.advisorLimit <= 10000
        && data.forecastUsed is number && data.forecastUsed >= 0 && data.forecastUsed <= 10000
        && data.lastResetAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasAuthorizedAiTier(userId, tier) {
      return (
        exists(/databases/$(database)/documents/vipSubscriptions/$(userId))
        && get(/databases/$(database)/documents/vipSubscriptions/$(userId)).data.status == 'active'
        && get(/databases/$(database)/documents/vipSubscriptions/$(userId)).data.periodEndAt > request.time
        && tier == get(/databases/$(database)/documents/vipSubscriptions/$(userId)).data.tier
      ) || (
        (
          !exists(/databases/$(database)/documents/vipSubscriptions/$(userId))
          || get(/databases/$(database)/documents/vipSubscriptions/$(userId)).data.status != 'active'
          || get(/databases/$(database)/documents/vipSubscriptions/$(userId)).data.periodEndAt <= request.time
        )
        && (
          (
            exists(/databases/$(database)/documents/securityProfiles/$(userId))
            && get(/databases/$(database)/documents/securityProfiles/$(userId)).data.vipStatus == 'vip'
            && tier == 'gold'
          ) || (
            (
              !exists(/databases/$(database)/documents/securityProfiles/$(userId))
              || get(/databases/$(database)/documents/securityProfiles/$(userId)).data.vipStatus != 'vip'
            )
            && tier == 'starter'
          )
        )
      );
    }

    function isValidVipPaymentRequest(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'displayName', 'tier', 'billingCycle', 'amountInr', 'upiId', 'paymentReference', 'utrReference', 'paymentMethodLabel', 'status', 'adminNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'displayName', 'tier', 'billingCycle', 'amountInr', 'upiId', 'paymentReference', 'utrReference', 'paymentMethodLabel', 'status', 'adminNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.tier in ['starter', 'silver', 'gold', 'diamond']
        && data.billingCycle in ['monthly', 'quarterly', 'yearly']
        && data.amountInr is number
        && isValidVipPrice(data.tier, data.billingCycle, data.amountInr)
        && data.upiId == 'tntmilan06@slc'
        && data.paymentReference is string && data.paymentReference.size() >= 6 && data.paymentReference.size() <= 64
        && data.paymentReference.matches('^FTPAY-[a-zA-Z0-9_\\-]+$')
        && data.utrReference is string && data.utrReference.size() >= 4 && data.utrReference.size() <= 64
        && data.paymentMethodLabel is string && data.paymentMethodLabel.size() >= 2 && data.paymentMethodLabel.size() <= 60
        && data.status in ['pending', 'approved', 'rejected']
        && data.adminNote is string && data.adminNote.size() <= 500
        && data.reviewedBy is string && data.reviewedBy.size() <= 160
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /appConfig/{configId} {
      allow get: if configId == 'maintenance';
      allow list: if false;
      allow create: if configId == 'maintenance'
        && isMaintenanceAdmin()
        && isValidMaintenanceConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if configId == 'maintenance'
        && isMaintenanceAdmin()
        && isValidMaintenanceConfig(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) && isValidId(userId)) || isMaintenanceAdmin();
      allow list: if isMaintenanceAdmin();
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active')
        && (!('deactivatedAt' in incoming()) || incoming().deactivatedAt == null)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isVerifiedOwner(userId)
            && (!('accountStatus' in existing()) || existing().accountStatus == 'active')
            && isNotBanned(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency', 'theme', 'monthlyBudgetLimit', 'openingBankBalance', 'openingCashBalance', 'updatedAt'])
          )
          || (
            isMaintenanceAdmin()
            && existing().email != 'maind.go2000@gmail.com'
            && incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'deactivatedAt', 'updatedAt'])
            && (incoming().accountStatus == 'active' ? incoming().deactivatedAt == null : incoming().deactivatedAt == request.time)
          )
        );
      allow delete: if isVerifiedOwner(userId)
        && isValidId(userId)
        && (!('accountStatus' in existing()) || existing().accountStatus == 'active')
        && isNotBanned(userId);

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && isActiveAccount(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isActiveAccount(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().recurringId == existing().recurringId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'title', 'category', 'date', 'time', 'paymentMethod', 'description', 'notes', 'receiptName', 'receiptDataUrl', 'updatedAt'])
          && isActiveAccount(userId);
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isActiveAccount(userId);
      }

      match /savingsGoals/{goalId} {
